# ── MemoryLane 环境变量 ──
# 复制此文件为 .env 并修改，然后 docker-compose up -d

# ===== AI 配置（至少填一个） =====
# 选哪个 provider 在启动后的设置页面随时切换，这里只填默认 API key
# 支持：OpenAI / DeepSeek / DashScope(通义) / Ollama / Anthropic / ZhiPu / Moonshot
LLM_API_KEY=sk-your-api-key-here
# LLM_MODEL=gpt-4o-mini       # 可选，默认 gpt-4o-mini

# ===== 数据库（可不动） =====
# DB_PASSWORD=memorylane123

# ===== 语义搜索（可选，需要 embedding API key） =====
# MEMORYLANE_EMBEDDING_ENABLED=true
